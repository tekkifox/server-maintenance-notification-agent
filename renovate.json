{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/London",
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "automerge": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Group Go module updates into a single PR",
      "matchManagers": ["gomod"],
      "groupName": "Go modules",
      "automerge": false
    },
    {
      "description": "Group Dockerfile base image updates into a single PR",
      "matchManagers": ["dockerfile"],
      "groupName": "Docker base images",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "description": "Hold non-major updates for the release-age cooldown; majors are exempt for human review",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "12 hours"
    },
    {
      "description": "Never automerge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    }
  ]
}
